# Copy to .env and edit.  (cp .env.example .env)

# Generate with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-with-a-long-random-secret

# 1 on your laptop, 0 on AWS
DEBUG=1

# Comma separated. On AWS add your EC2 public IP / Elastic IP / domain name.
ALLOWED_HOSTS=localhost,127.0.0.1

# Only if you hit "CSRF verification failed" behind a domain/proxy, e.g. http://54.164.149.60
CSRF_TRUSTED_ORIGINS=

# Keep 0 until a TLS certificate is installed (otherwise the site redirects to https and times out).
USE_HTTPS=0

# Default is SQLite in instance/civicpulse.sqlite3. For RDS PostgreSQL use:
# DATABASE_URL=postgres://USER:PASSWORD@HOST.us-east-1.rds.amazonaws.com:5432/civicpulse

MAX_CONTENT_LENGTH=5242880
TIME_ZONE=Asia/Kolkata
